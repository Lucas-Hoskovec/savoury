# === Database (Supabase en dev local / Render Postgres en production) ===
# Connection string PostgreSQL. Format:
# postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# === Auth (iron-session) ===
# Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-32-bytes-secret"

# === Supabase Storage ===
# Project URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# Anon/public key (safe for the browser, used to build public image URLs)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key (SERVER ONLY - never expose to the client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Buckets publics créés par `npm run db:ensure-buckets` : recipe-images (photos de recettes)
# et user-avatars (photos de profil).

# === Google Ads / Analytics (optionnel, Google Consent Mode v2) ===
# Laisser vide pour désactiver. Les tags ne chargent qu'après consentement.
# GA4 Measurement ID : G-XXXXXXXXXX — Google Ads Conversion ID : AW-XXXXXXXXX
NEXT_PUBLIC_GTAG_ID=""
NEXT_PUBLIC_ADS_ID=""